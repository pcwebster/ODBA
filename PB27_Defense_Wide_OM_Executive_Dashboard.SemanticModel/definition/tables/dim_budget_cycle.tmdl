	partition dim_budget_cycle = m
		mode: import
		source =
				let
					Raw = Csv.Document(File.Contents("C:\Users\peter\ODBA DBDP-114 Check\consumption\dim_budget_cycle.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					CheckedHeaders = if Table.ColumnNames(Headers) = {"source_file", "budget_year", "lifecycle_stage", "acquisition_date", "ingest_status", "source_url", "sha256"} then Headers else error "DBDP-114: unexpected CSV headers",
					Typed = Table.Buffer(Table.TransformColumnTypes(CheckedHeaders, {{"source_file", type text}, {"budget_year", Int64.Type}, {"lifecycle_stage", type text}, {"acquisition_date", type date}, {"ingest_status", type text}, {"source_url", type text}, {"sha256", type text}}, "en-US")),
					Errors = Table.RowCount(Table.SelectRowsWithErrors(Typed)),
					Checked = if Errors <> 0 then error "DBDP-114: conversion errors" else if Table.RowCount(Typed) <> 149 then error "DBDP-114: wrong number of rows" else Typed
				in
					Checked

	annotation PBI_ResultType = Table

